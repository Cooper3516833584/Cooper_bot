# 复制需要的键到受保护的 secrets.env；不要把真实 Kimi provider/OAuth 凭据提交到仓库。
AI_KIMI_ENABLED=true
AI_KIMI_CLI_PATH=C:/VerifiedKimi/kimi.exe
# 留空时继承 profile 中已经验证的 default_model，不在这里猜测 model ID。
AI_KIMI_MODEL=
AI_KIMI_PUBLIC_HOME=C:/CooperBotRuntime/kimi/public
AI_KIMI_ADMIN_HOME=C:/CooperBotRuntime/kimi/admin
AI_KIMI_PUBLIC_WORKDIR=C:/CooperBotRuntime/work/kimi-public
AI_KIMI_ADMIN_WORKDIR=C:/CooperBotWorkspace
AI_KIMI_TIMEOUT_SECONDS=120
AI_KIMI_ADMIN_TIMEOUT_SECONDS=480
AI_KIMI_MAX_CONCURRENCY=3
AI_KIMI_ADMIN_ENABLED=false
AI_KIMI_ALLOW_GROUP_COMPUTER=false
